# Neon 콘솔(https://console.neon.tech) → 프로젝트 → Connect 에서 복사한 연결 문자열
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 데모 데이터(서울시청 주변 가게 9곳 + 데모 계정)를 넣지 않으려면 false
# SEED_DEMO=false

# ── Google 소셜 로그인 (Firebase Authentication) ──
# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹) → SDK 설정의 firebaseConfig 값. 공개용 설정이라 비밀 값이 아니에요.
# 비워 두면 Google 로그인 버튼이 숨겨집니다.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── 비밀번호 재설정 메일 (우리 디자인으로 직접 발송) ──
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → 받은 JSON 파일 내용을 한 줄로 (비밀 값!)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Resend API 키 (비밀 값!)
RESEND_API_KEY=
# 보내는 사람. 내 도메인을 Resend에 인증한 뒤 바꾸기 (기본값: 붕세권 <onboarding@resend.dev>)
# EMAIL_FROM="붕세권 <noreply@내도메인.com>"
